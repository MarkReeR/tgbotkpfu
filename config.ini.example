; Любую настройку ниже можно переопределить переменной окружения — см. README.
; В Docker обычно используют только переменные, а этот файл не нужен вовсе.

[runArgs]
; Токен бота от @BotFather
BotKey = PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE

; Куда писать логи и с каким минимальным уровнем: DEBUG, INFO, WARN, ERROR
LogDir = logs
LogLevel = INFO

; Файл SQLite, в котором хранится выбранная пользователем группа
DatabasePath = Database.db

; Часовой пояс, по которому считаются "сегодня" и "завтра"
Timezone = Europe/Moscow

[schedule]
; ID документа Google Sheets (длинный id в ссылке, между /d/ и /edit)
SpreadsheetId = 1aXfcSn63NthC8wxfawc6zYGVlLDuz82WaTe4EHYQpfw

; Пары "ИмяЛиста:gid" через запятую. gid виден в адресной строке как #gid=...
; после клика по вкладке. Обычная правка данных внутри вкладки gid не меняет,
; так что трогать это нужно только если вкладки пересоздадут заново.
Sheets = 1 курс:0,2 курс:1091191709,3 курс:92806381,4 курс:581856196,5 курс:1325846251,6 курс:782502099

; Как часто перекачивать таблицу, в минутах
RefreshMinutes = 15

; Дата начала семестра в формате ГГГГ-ММ-ДД. Неделя, в которую попадает эта
; дата, считается ВЕРХНЕЙ ("в"), дальше недели чередуются.
; Задавайте каждый семестр вместе со сменой SpreadsheetId.
; Если не указать - берётся 1 сентября текущего учебного года.
SemesterStart = 2026-09-01

[physed]
; Расписание физкультуры для спецмед групп — отдельная таблица, которую
; ведут вручную (в основном расписании ВУЗа его нет).
; Структура листа: первая строка — время (8:00, 9:40, ...), дальше строки
; вида "пн - в" / "пн - н", в ячейках фамилия преподавателя.
; Оставьте SpreadsheetId пустым, чтобы отключить раздел.
SpreadsheetId = 1BP7nX6hkxqsOKBTScu0DvRodCZP9g9Cbo9QbEN6777M
Gid = 0

; Место занятий — одно на все пары, поэтому живёт здесь, а не в таблице.
Venue = Спорткомплекс

[exams]
; Показывать ли кнопку "Экзамены" в главном меню.
; Включайте на период сессии/зачётов, потом возвращайте в false.
; Меняется только с перезапуском бота.
Show = false
